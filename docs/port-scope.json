    "app_v2/src/main/assets/help/**/system-info*"
  ],
  "exclude": [
    { "glob": "temp/**", "reason": "the upstream's scratch and archive trees (temp/scratch, temp/archive) hold copies, not sources" },
    { "glob": "**/build/**", "reason": "build output is generated, not source" },
    { "glob": "app_v2/src/main/java/com/sza/fastmediasorter/service/WearDataLayerPaths.kt", "reason": "rewritten on purpose, not ported: the product's own object declares the two System Info routes under /deviceinfo/ (DATA-LAYER-PAIR, S0005), the upstream object is a catalogue of about sixty /fms/ routes of FMS_A's other sub-programs" },
    { "glob": "wear/src/main/java/com/sza/fastmediasorter/wear/data/wear/WearDataLayerPaths.kt", "reason": "rewritten on purpose, not ported: the watch-side mirror of the same two-route object under /deviceinfo/ (DATA-LAYER-PAIR, S0005); a payload or path change upstream reaches this product through the System Info report payload, which is ledgered" }
  ],
  "strings": {
    "scan": [
      "app_v2/src/main/res/values*/*.xml",
      "app_v2/src/noLegal/res/values*/*.xml",
      "wear/src/main/res/values*/*.xml"
    ],
    "prefixes": ["sysinfo_", "system_info_", "nolegal_diag_"],
    "destinationScan": [
      "phone/src/**/res/values*/*.xml",
      "wear/src/**/res/values*/*.xml"
    ]
  }
}
