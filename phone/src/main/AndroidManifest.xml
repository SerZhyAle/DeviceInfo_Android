<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets the Network section of the report tell whether the device is online, on Wi-Fi or mobile data,
         metered or behind a VPN. The only permission the System info collectors use. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Lets the phone tell you that a system information report arrived from your watch, with a tap that opens
         or sends it. Declared and used by WearSystemInfoReportReceiver; the app has no INTERNET permission. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Package visibility (API 30+) for the one app whose version the OS section of the report names:
         Google Play services. Without it the field would read "not installed" on every device. -->
    <queries>
        <package android:name="com.google.android.gms" />
    </queries>

    <!-- allowBackup is off: the app keeps only which report sections are expanded and whether the notification
         question was answered, and the privacy page says that nothing it holds leaves the device. -->
    <application
        android:name=".DeviceInfoApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DeviceInfo">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.systeminfo.SystemInfoActivity"
            android:exported="false"
            android:label="@string/settings_system_info_title" />

        <service
            android:name=".service.PhoneWearListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/deviceinfo/watch"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>
    </application>
</manifest>
