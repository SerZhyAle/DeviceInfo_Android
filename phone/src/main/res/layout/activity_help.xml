<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.sza.deviceinfo.ui.common.widget.StandardToolbar
        android:id="@+id/help_toolbar"
        style="@style/Widget.DeviceInfo.Toolbar.Flat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:stbTitleIcon="@drawable/ic_help_outline"
        android:title="@string/help"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:menu="@menu/menu_help" />

    <WebView
        android:id="@+id/help_web_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
